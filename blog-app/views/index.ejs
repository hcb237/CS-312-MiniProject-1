<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <!-- Viewport meta tag to work on phones -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Mini Blog</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <!-- Page header with the site title and tagline -->
  <header class="site-header">
    <h1>Mini Blog</h1>
    <p>Share your thoughts with the world</p>
  </header>

  <main>
    <!-- ============ New Post Form ============ -->
    <section class="card">
      <h2>Create a New Post</h2>

      <!-- Submits via POST to /post-->
      <form action="/posts" method="POST" class="post-form">

        <!-- Author field -->
        <div class="form-group">
          <label for="author">Your Name</label>
          <input type="text" id="author" name="author" placeholder="e.g. Jane Doe" required />
        </div>

        <!-- Title field -->
        <div class="form-group">
          <label for="title">Blog Title</label>
          <input type="text" id="title" name="title" placeholder="e.g. My First Post" required />
        </div>

        <!-- Content field (textarea for longer text) -->
        <div class="form-group">
          <label for="content">Blog Content</label>
          <textarea id="content" name="content" rows="6" placeholder="Write your blog here..." required></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Publish Post</button>
      </form>
    </section>

    <!-- ============ Post List ============ -->
    <section class="posts-section">
      <!-- Show how many posts exist -->
      <h2>All Posts: (<%= posts.length %>)</h2>

      <!-- If no posts, show a message -->
      <% if (posts.length === 0) { %>
        <p class="empty-msg">No posts yet. Be the first!</p>
      <% } else { %>

        <!-- Loop through each post, render a card for it -->
        <% for (let i = 0; i < posts.length; i++) { %>
          <% const post = posts[i]; %>

          <article class="post-card">
            <!-- Title -->
            <h3><%= post.title %></h3>

            <!-- Metadata: author, creation time, and edit time (if edited) -->
            <div class="post-meta">
              <span>By <%= post.author %></span>
              <span>Posted: <%= post.createdAt %></span>
              <% if (post.updatedAt) { %>
                <span>Edited: <%= post.updatedAt %></span>
              <% } %>
            </div>

            <!-- Content, escaped. line breaks are preserved by CSS's white-space -->
            <p class="post-content"><%= post.content %></p>

            <div class="post-actions">
              <!-- Edit is a plain GET link to /posts/:id/edit -->
              <a href="/posts/<%= post.id %>/edit" class="btn btn-edit">Edit</a>

              <!-- Use psot fort delete so url visit doesn't trigger it -->
              <form action="/posts/<%= post.id %>/delete" method="POST" class="inline-form">
                <button type="submit" class="btn btn-delete">Delete</button>
              </form>
            </div>
          </article>
        <% } %>
      <% } %>
    </section>
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <p>built by Hugh for cs 312</p>
  </footer>
</body>
</html>