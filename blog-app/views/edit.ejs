<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Post</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="site-header">
    <h1>Edit Post</h1>
  </header>

  <main>
    <section class="card">
            <h2>Edit Post</h2>

        <!-- Create form, prefilled with old content, delete origonal on confirm -->
        <form action="/posts/<%= post.id %>/replace" method="POST" class="post-form">

        <div class="form-group">
            <label for="author">Author</label>
            <input type="text" id="author" name="author" value="<%= post.author %>" required />
        </div>

        <div class="form-group">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" value="<%= post.title %>" required />
        </div>

        <div class="form-group">
            <label for="content">Content</label>
            <!-- Textarea contents go between the tags, not in a value attribute -->
            <textarea id="content" name="content" rows="6" required><%= post.content %></textarea>
        </div>

        <div class="form-actions">
            <!-- Submits the data as a NEW post then removes the old one -->
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <!-- Cancel goes back to the homepage without saving -->
            <a href="/" class="btn btn-secondary">Cancel</a>
        </div>
        </form>
    </section>
  </main>

  <footer class="site-footer">
    <p>built by Hugh for cs312</p>
  </footer>
</body>
</html>